# Obelus — environment variables (architecture §16)
# Copy to .env.local and fill in. .env.local is git-ignored. Never commit keys.
# Rotate any key that ever appears in a commit.

# --- LLM: extraction + summary only. The model never assigns a verdict (§3). ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Domain-restricted search. Free tier: 1,000 credits/month, resets on the 1st. ---
# Used for the AUDIT fallback and PARTNERSHIP checks only; CertiK is fetched by
# direct slug to stay off this budget (§10.2).
TAVILY_API_KEY=

# --- Base mainnet RPC. Public endpoint works; Alchemy free key avoids throttling (§20). ---
BASE_RPC_URL=https://mainnet.base.org

# --- Reports, caches, rate limits. Falls back to in-memory when unset (local dev). ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Telegram bot (§14). Webhook mode. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- EAS receipts on Base (§11). ---
# ATTESTER_PRIVATE_KEY: a DEDICATED wallet holding a few dollars of ETH only.
# NEVER the wallet registered for the hackathon.
ATTESTER_PRIVATE_KEY=
EAS_SCHEMA_UID=
# Where receipts are written: "base-sepolia" (testnet, free faucet ETH) or "base" (mainnet).
# Only receipts — the checkers always read Base mainnet via BASE_RPC_URL.
EAS_CHAIN=base-sepolia
# Optional override for the receipt network's RPC (defaults to that network's public RPC).
EAS_RPC_URL=

# --- Public URL of the deployment, used in share links and the Telegram webhook. ---
PUBLIC_BASE_URL=http://localhost:3000
