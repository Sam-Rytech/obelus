{
  "name": "obelus",
  "version": "0.1.0",
  "private": true,
  "description": "Fact-checker for crypto announcements. The model reads, code decides.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
