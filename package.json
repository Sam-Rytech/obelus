    "@upstash/redis": "^1.35.7",
    "ccxt": "^4.5.9",
    "ethers": "^6.15.0",
    "grammy": "^1.38.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.37.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
